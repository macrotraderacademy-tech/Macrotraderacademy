# Development image: only dependencies are baked. Application source is
# bind-mounted by docker-compose.base44.yml so edits are picked up live by
# `next dev`. Rebuild when package.json / package-lock.json change.
FROM node:22

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

CMD ["npm", "run", "dev"]
